# Build artifacts
/imapsync-go
/dist/
/bin/
/completions/
/share/
/coverage.out
/coverage.html
/.task/

# Local state and spool
*.db
*.db-journal
*.db-wal
*.db-shm

# Local configuration that may reference real accounts
/imapsync.yaml
/imapsync.local.yaml

# Worktrees, if adopted later
/.worktrees/
/worktrees/

# Editor / OS noise
.DS_Store
*.swp

# OAuth client secrets and minted tokens (real credentials, never commit).
# The Google console downloads its client as client_secret_*.json; a refresh
# blob may be called anything, so /secrets/ is the place to put one.
/client_secret_*.json
/*.oauth.json
/secrets/

# Sample messages captured from real accounts (personal mail, never commit)
/samples/
